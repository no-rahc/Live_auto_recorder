LIVE_AUTO_RECORDER_IMAGE=yeowoonlee/live-auto-recorder:latest
APP_PORT=5000
TZ=Asia/Seoul
LOG_LEVEL=info
ALLOW_SECRET_BACKUPS=false
CONFIG_PATH=./data
RECORDINGS_PATH=./recordings
LOG_PATH=./logs
TMP_PATH=./tmp

# The v2 UI is the default. This flag opts into the durable engine only.
# Existing recording engines and /legacy remain available without the flag.
# Keep metadata on local persistent storage, never SMB/NFS-mounted SQLite WAL.
LAR_V2_ENABLED=false
# Explicit additional hostnames for protected remote access (comma-separated).
LAR_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Optional registered local/NAS archive-copy destination. Original is retained.
# LAR_V2_ARCHIVE_ROOT=/archive
# Existing marker on the intended volume; never auto-created in a missing mount.
LAR_V2_RECORDINGS_MARKER=.lar-storage-id
# LAR_V2_RECORDINGS_MARKER_VALUE=my-recorder-volume-id
# LAR_V2_ARCHIVE_MARKER=.lar-storage-id
# LAR_V2_ARCHIVE_MARKER_VALUE=my-archive-volume-id
